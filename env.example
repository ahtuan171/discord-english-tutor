# Copy this file to ".env" and fill in your real values. Never commit ".env".

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DAILY_CHANNEL_ID=123456789012345678
GUILD_ID=123456789012345678

# --- Database (PostgreSQL) ---
# Use the Supabase "Session pooler" / "Transaction pooler" connection string
# (not the direct "db.xxx.supabase.co" host, which is IPv6-only).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_tutor

# --- Scheduler ---
# Local time the Daily Drop is posted, e.g. 08:00
DAILY_HOUR=8
DAILY_MINUTE=0
TIMEZONE=Asia/Ho_Chi_Minh
